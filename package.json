{
  "name": "noleaker",
  "version": "0.3.2",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "MV3 browser extension (Chrome and Firefox): SOCKS5 proxy manager with leak protection",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:firefox": "node scripts/dev.mjs firefox",
    "start:firefox": "web-ext run -s dist/firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "tsc --noEmit && node scripts/build.mjs chrome",
    "build:firefox": "tsc --noEmit -p tsconfig.firefox.json && node scripts/build.mjs firefox",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.firefox.json",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint -s dist/firefox --self-hosted",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "snapshot": "node scripts/update-snapshot.mjs",
    "socks": "node scripts/socks5-server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "release": "scripts/release.sh",
    "e2e:firefox": "node --test tests/e2e/firefox.e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/selenium-webdriver": "^4.35.7",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
